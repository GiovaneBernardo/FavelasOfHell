// Per-view constants. MIRRORED by foh::ViewConstants in
// engine/renderer/src/gpu_structs.h: change both together (the C++ side has
// static_asserts on size and offsets).
#pragma once

struct ViewConstants {
    float4x4 view;
    float4x4 proj;
    float4x4 viewProj;
    float4x4 invViewProj;
    float4 cameraPos;    // xyz
    float4 sunDirection; // xyz = direction the light travels (normalized), w = 1 if a sun exists
    float4 sunColor;     // rgb, already multiplied by intensity
    float4 viewport;     // xy = size in pixels, zw = 1 / size
    float4 params;       // x = exposure, y = time (s), z = near, w = far

    // Sun shadows (cascaded shadow map atlas, 2x2 tiles; see foh/renderer/shadow_cascades.h).
    float4x4 cascadeViewProj[4]; // world -> clip space of each cascade
    float4 cascadeSplits;        // view-space depth where each cascade ends
    float4 cascadeTexel;         // world-space size of one shadow texel, per cascade
    float4 shadowParams;         // x = 1 / atlas size (texels), y = tile size (uv), z = unused, w = 1 if shadows are on

    // Precomputed atmosphere (common/atmosphere.slangh); atmosphere1.y = 0 when the tables are not ready or the view has no sun.
    float4 atmosphere0; // x = bottom radius (km), y = top radius, z = mu_s_min, w = Mie phase g
    float4 atmosphere1; // x = sun angular radius (rad), y = 1 if the atmosphere is on
    float4 atmosphere2; // xyz = single-Mie extrapolation factor
    float4 atmosphere3; // xyz = ground albedo

    float4 render; // x = 1 to dither the tonemapped output, y = 1 for aerial perspective (needs atmosphere1.y)

    // Indirect light and small-scale shadowing (common/lighting.slangh). Every feature is switched by a flag here, so a
    // viewport that does not run it binds stand-in textures and the shader skips the work.
    float4 ssao;   // x = 1 if the GTAO texture is valid, y = strength (exponent), z = contact shadow length (m, 0 = off), w = GTAO radius (m)
    float4 canopy; // x = leaf transmission strength (0 = off), y = 1 if the foliage transmission atlas is valid
    float4 ibl;    // x = 1 if the sky environment is valid, y = its intensity, z = 1 if the probe grid is valid, w = probe cell size (m)
    float4 probeA; // xy = world xz of the centre of the probe window, z = probes per side, w = intensity
    float4 probeB; // x = height of probe layer 0 above the ground (m), y = layer 1, zw = unused
    float4 bed;    // xy = origin (m), zw = 1 / size (1 / m) of the ground height field (the water's sea floor)
};

// World-space point under a pixel at the given depth (reverse-Z: near plane is depth 1).
float3 worldPointAt(float4x4 invViewProj, float2 ndc, float depth)
{
    float4 p = mul(invViewProj, float4(ndc, depth, 1.0));
    return p.xyz / p.w;
}
