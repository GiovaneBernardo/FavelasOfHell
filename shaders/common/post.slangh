// Constants of the post-processing passes (auto exposure, bloom composite, tonemap). MIRRORED by foh::PostConstants in
// engine/renderer/src/post_process.h: change both together (the C++ side has a static_assert on the size).
#pragma once

struct PostConstants {
    float4 bloom;    // x = strength (0 = off), y = unused
    float4 exposure; // x = manual exposure (linear), y = 1 for auto exposure, z = compensation (EV), w = 1 to snap to the target (no adaptation)
    float4 adapt;    // x = lowest scene luminance (log2) the histogram covers, y = highest, z = speed when the scene gets brighter (1/s), w = when darker
    float4 meter;    // x = delta time (s), y = histogram low percentile, z = high percentile, w = center weighting (0 = whole image)
    float4 tonemap;  // x = operator (TonemapOperator), y = white point (Reinhard extended)
    float4 size;     // xy = size in pixels of the image the histogram samples
};

static const uint kHistogramBins = 256;
// Fixed-point scale of the histogram weights (center weighting makes them fractional).
static const float kHistogramWeightScale = 64.0;

float luminance(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}
