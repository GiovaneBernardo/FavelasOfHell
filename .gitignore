# Build output / IDE
/out/
/build/
/.vs/
/.vcpkg/
/vcpkg_installed/
CMakeUserPresets.json
*.user
compile_commands.json


# Cooked assets / caches (never commit)
/cache/
/.hotreload/

# Models/textures dropped into the editor are copied here (with their .meta files) until curated into assets/
/assets/imported/
# Packages downloaded by the editor's assets workshop (licensed third-party content, large)
/assets/workshop/

# Downloaded source data for the world tools (tools/fetch_rio_dem.py); the derived world/rio_dem.fohdem is committed
/data/

# The district is derived from OpenStreetMap + the heightmap (tools/fetch_osm_district.py, tools/build_district.py); the patch is 21 MB
/world/district_*.fohcity
/world/*_ground.fohp
